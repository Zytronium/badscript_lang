var name = "Jobama"
var boolean = True
var nothing = Null

print("Var name is ")
println(name)
println()
print("Var boolean is ")
println(boolean)
println()
print("Var nothing is ")
println(nothing)
println()

println("Reassigning the value of 'nothing'...")
nothing = "something"

print("New value of 'nothing': ")
println(nothing)
